{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consortium.local/schema/adard-run.schema.json",
  "title": "Consortium ADARD run status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task",
    "state",
    "phase",
    "budget",
    "artifacts",
    "lineage",
    "generation",
    "repair_attempts",
    "rage_cycles",
    "usage",
    "implementation_identity",
    "approved_decisions",
    "started_at"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["running", "blocked", "rejected", "cancelled", "failed", "complete"]
    },
    "phase": {
      "enum": [
        "analyze",
        "design",
        "adversarial_review",
        "resolve",
        "develop",
        "verify"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_tokens", "max_cost_usd", "time_limit"],
      "properties": {
        "max_total_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "time_limit": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_run_id", "rage_cycle"],
      "properties": {
        "parent_run_id": { "type": ["string", "null"] },
        "rage_cycle": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "cost_usd",
        "tokens_known",
        "cost_known"
      ],
      "properties": {
        "model_calls": { "type": "integer", "minimum": 0 },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "tokens_known": { "type": "boolean" },
        "cost_known": { "type": "boolean" }
      }
    },
    "implementation_identity": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "type": "string" },
            "value": { "type": "string" }
          }
        }
      ]
    },
    "approved_decisions": { "type": "array" },
    "generation": { "type": "integer", "minimum": 0 },
    "repair_attempts": { "type": "integer", "minimum": 0 },
    "rage_cycles": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "number" }
  }
}
